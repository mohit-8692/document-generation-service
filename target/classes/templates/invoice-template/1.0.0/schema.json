{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "invoice-template v1.0.0",
  "type": "object",
  "required": ["invoiceNumber", "customerName", "amount", "items"],
  "properties": {
    "invoiceNumber": { "type": "string" },
    "customerName": { "type": "string" },
    "amount": { "type": "number" },
    "isPaid": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": { "type": "string" },
          "price": { "type": "number" }
        }
      }
    }
  }
}
